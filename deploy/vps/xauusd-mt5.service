[Unit]
Description=XAUUSD MetaTrader 5 demo terminal
Requires=xauusd-xvfb.service
After=network-online.target xauusd-xvfb.service
Wants=network-online.target

[Service]
Type=simple
User=perrucci
WorkingDirectory=/opt/xauusd-mt5-demo
Environment=HOME=/home/perrucci
Environment=DISPLAY=:99
Environment=WINEPREFIX=/home/perrucci/.mt5
ExecStart=/usr/bin/wine "/home/perrucci/.mt5/drive_c/Program Files/MetaTrader 5/terminal64.exe"
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
