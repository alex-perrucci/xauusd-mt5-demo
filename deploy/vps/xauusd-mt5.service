[Unit]
Description=XAUUSD MetaTrader 5 demo terminal with native MQL5 bridge
Requires=xauusd-xvfb.service
After=network-online.target xauusd-xvfb.service
Wants=network-online.target

[Service]
Type=simple
User=perrucci
WorkingDirectory=/opt/xauusd-mt5-demo
Environment=HOME=/home/perrucci
Environment=DISPLAY=:99
Environment=WINEPREFIX=/home/perrucci/.mt5
Environment=WINEDEBUG=-all
Environment=PATH=/opt/wine-devel/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/bash /opt/xauusd-mt5-demo/scripts/vps/run-mt5.sh
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
